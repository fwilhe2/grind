# `grind serve` (doc/server.md): the browser shell and a directory of documents behind it.
#
#   docker build -f server/Containerfile -t grind-server .
#   docker run --rm --init --network host -v "$PWD/documents:/documents:z" grind-server
#
# The server listens on 127.0.0.1 only (doc/local-only.md), so `-p` cannot reach it: the
# container shares the host's network and the page is at http://127.0.0.1:8080/ on that host.
# Reaching it from another computer is a reverse proxy you run yourself (`--host` names it).
#
# The context is the repository root: the page and the binary are built from the same tree,
# which is what keeps them the same build.

FROM docker.io/rust:1-bookworm AS build
RUN rustup target add wasm32-unknown-unknown
WORKDIR /src

# Cargo.lock alone decides which wasm-bindgen-cli the page needs, so the slow install is a layer
# only a dependency change invalidates (the same arrangement as ui_web/Dockerfile).
COPY Cargo.lock .
RUN version="$(grep -A1 '^name = "wasm-bindgen"$' Cargo.lock \
        | sed -n 's/^version = "\(.*\)"/\1/p' | head -n1)" \
    && cargo install wasm-bindgen-cli --version "$version" --locked

COPY . .
RUN ./ui_web/build.sh release && cargo build --release --locked -p grind-cli

# Bookworm, as the build stage: the binary asks for no newer glibc than this image has. Not
# distroless, because history is git commits and that needs the `git` executable.
FROM docker.io/debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    # The documents belong to whoever owns the volume, not to the user this runs as.
    && git config --system safe.directory '*'
COPY --from=build /src/target/release/grind /usr/bin/grind
# Where `grind serve` looks for the page when it is given no --page.
COPY --from=build /src/ui_web/dist /usr/share/grind/web

USER 65532:65532
VOLUME /documents
CMD ["grind", "serve", "/documents", "--port", "8080"]
