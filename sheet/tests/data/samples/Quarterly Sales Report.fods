    table:name="Assumptions"
    table:style-name="ta1">
    <table:table-column
     table:style-name="co10"
     table:default-cell-style-name="Default"/>
    <table:table-column
     table:style-name="co11"
     table:default-cell-style-name="ce44"/>
    <table:table-row table:style-name="ro3">
     <table:table-cell
      table:style-name="ce43"
      office:value-type="string">
      <text:p>Business Assumptions &amp; Parameters</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="Default"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell/>
     <table:table-cell table:style-name="Default"/>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string">
      <text:p>VAT rate</text:p>
     </table:table-cell>
     <table:table-cell
      office:value-type="percentage"
      office:value="0.19">
      <text:p>19.0%</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string">
      <text:p>Volume discount threshold (units)</text:p>
     </table:table-cell>
     <table:table-cell
      table:style-name="ce45"
      office:value-type="float"
      office:value="100">
      <text:p>100</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string">
      <text:p>Volume discount rate</text:p>
     </table:table-cell>
     <table:table-cell
      office:value-type="percentage"
      office:value="0.05">
      <text:p>5.0%</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string">
      <text:p>Target gross margin</text:p>
     </table:table-cell>
     <table:table-cell
      office:value-type="percentage"
      office:value="0.35">
      <text:p>35.0%</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string">
      <text:p>Currency</text:p>
     </table:table-cell>
     <table:table-cell
      table:style-name="ce46"
      office:value-type="string">
      <text:p>EUR</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro2">
     <table:table-cell office:value-type="string">
      <text:p>Reporting quarter</text:p>
     </table:table-cell>
     <table:table-cell
      table:style-name="ce46"
      office:value-type="string">
      <text:p>Q3 2026</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <table:named-expressions>
    <table:named-range
     table:name="DiscountRate"
     table:base-cell-address="$Assumptions.$A$1"
     table:cell-range-address="$Assumptions.$B$5"/>
    <table:named-range
     table:name="DiscountThreshold"
     table:base-cell-address="$Assumptions.$A$1"
     table:cell-range-address="$Assumptions.$B$4"/>
    <table:named-range
     table:name="ProductNames"
     table:base-cell-address="$Products.$A$1"
     table:cell-range-address="$Products.$A$2:.$A$11"/>
    <table:named-range
     table:name="ProductTable"
     table:base-cell-address="$Products.$A$1"
     table:cell-range-address="$Products.$A$2:.$E$11"/>
    <table:named-range
     table:name="TargetMargin"
     table:base-cell-address="$Assumptions.$A$1"
     table:cell-range-address="$Assumptions.$B$6"/>
    <table:named-range
     table:name="VATRate"
     table:base-cell-address="$Assumptions.$A$1"
     table:cell-range-address="$Assumptions.$B$3"/>
   </table:named-expressions>
  </office:spreadsheet>
 </office:body>
</office:document>