 <office:body>
  <office:spreadsheet>
   <table:calculation-settings table:case-sensitive="false" table:use-regular-expressions="false" table:use-wildcards="true"/>
   <table:table table:name="Invoice" table:style-name="ta1">
    <table:table-column table:style-name="wide" table:number-columns-repeated="4" table:default-cell-style-name="Default"/>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Item</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Quantity</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Unit price</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Net</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Consulting hours</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="7.25" calcext:value-type="float">
      <text:p>7.25</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="95" calcext:value-type="float">
      <text:p>95</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=[.B2]*[.C2]" office:value-type="float" office:value="688.75" calcext:value-type="float">
      <text:p>688.75</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Travel, per km</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="183" calcext:value-type="float">
      <text:p>183</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="0.42" calcext:value-type="float">
      <text:p>0.42</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=[.B3]*[.C3]" office:value-type="float" office:value="76.86" calcext:value-type="float">
      <text:p>76.86</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Printed handouts</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="35" calcext:value-type="float">
      <text:p>35</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="1.85" calcext:value-type="float">
      <text:p>1.85</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=[.B4]*[.C4]" office:value-type="float" office:value="64.75" calcext:value-type="float">
      <text:p>64.75</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Room hire, half day</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="1" calcext:value-type="float">
      <text:p>1</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="240" calcext:value-type="float">
      <text:p>240</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=[.B5]*[.C5]" office:value-type="float" office:value="240" calcext:value-type="float">
      <text:p>240</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Catering, per person</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="18" calcext:value-type="float">
      <text:p>18</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="12.4" calcext:value-type="float">
      <text:p>12.4</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=[.B6]*[.C6]" office:value-type="float" office:value="223.2" calcext:value-type="float">
      <text:p>223.2</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:number-columns-repeated="4"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>VAT rate</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="0.19" calcext:value-type="float">
      <text:p>0.19</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Credit note</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="-12.34" calcext:value-type="float">
      <text:p>-12.34</text:p>
     </table:table-cell>
     <table:table-cell table:number-columns-repeated="2"/>
    </table:table-row>
   </table:table>
   <table:table table:name="Times" table:style-name="ta1">
    <table:table-column table:style-name="wide" table:number-columns-repeated="2" table:default-cell-style-name="Default"/>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Task</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Minutes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Call with the client</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="47" calcext:value-type="float">
      <text:p>47</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Drafting the report</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="133" calcext:value-type="float">
      <text:p>133</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Review</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="22" calcext:value-type="float">
      <text:p>22</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Site visit</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="188" calcext:value-type="float">
      <text:p>188</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Boxes per pallet</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="40" calcext:value-type="float">
      <text:p>40</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Boxes to ship</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="257" calcext:value-type="float">
      <text:p>257</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <table:table table:name="Samples" table:style-name="ta1">
    <table:table-column table:style-name="co3" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co4" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co5" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co4" table:default-cell-style-name="Default"/>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Function</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Formula</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Result</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>What it shows</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ROUND</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=ROUND(SUM(Invoice.D2:D6)*Invoice.B8;2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=ROUND(SUM([Invoice.D2:.D6])*[Invoice.B8];2)" office:value-type="float" office:value="245.78" calcext:value-type="float">
      <text:p>245.78</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>VAT on the invoice, to the cent</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ROUND</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=ROUND(SUM(Invoice.D2:D6);-2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=ROUND(SUM([Invoice.D2:.D6]);-2)" office:value-type="float" office:value="1300" calcext:value-type="float">
      <text:p>1300</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The invoice to the nearest hundred, for a forecast</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>INT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=INT(Times.B3/60)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=INT([Times.B3]/60)" office:value-type="float" office:value="2" calcext:value-type="float">
      <text:p>2</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Whole hours in the drafting time</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>INT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=INT(Invoice.B9)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=INT([Invoice.B9])" office:value-type="float" office:value="-13" calcext:value-type="float">
      <text:p>-13</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>INT steps down, so a credit of -12.34 becomes -13</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>TRUNC</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=TRUNC(Invoice.B9)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=TRUNC([Invoice.B9])" office:value-type="float" office:value="-12" calcext:value-type="float">
      <text:p>-12</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>TRUNC cuts towards zero: -12</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>TRUNC</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=TRUNC((DATE(2026;9;30)-DATE(2019;3;15))/365.25)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=TRUNC((DATE(2026;9;30)-DATE(2019;3;15))/365.25)" office:value-type="float" office:value="7" calcext:value-type="float">
      <text:p>7</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Whole years of service</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ROUNDUP</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=ROUNDUP(Times.B2/15;0)*15</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=ROUNDUP([Times.B2]/15;0)*15" office:value-type="float" office:value="60" calcext:value-type="float">
      <text:p>60</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The call, billed in started quarter hours</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ROUNDDOWN</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=ROUNDDOWN(SUM(Invoice.D2:D6);0)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=ROUNDDOWN(SUM([Invoice.D2:.D6]);0)" office:value-type="float" office:value="1293" calcext:value-type="float">
      <text:p>1293</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Loyalty points: one per whole euro</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>MROUND</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=MROUND(Times.B5;5)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=MROUND([Times.B5];5)" office:value-type="float" office:value="190" calcext:value-type="float">
      <text:p>190</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The site visit to the nearest five minutes</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>MROUND</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=MROUND(Invoice.C6*1.07;0.05)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=MROUND([Invoice.C6]*1.07;0.05)" office:value-type="float" office:value="13.25" calcext:value-type="float">
      <text:p>13.25</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Catering with 7% added, to the nearest five cents</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>CEILING</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=CEILING(Times.B7/Times.B6)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=CEILING([Times.B7]/[Times.B6])" office:value-type="float" office:value="7" calcext:value-type="float">
      <text:p>7</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Pallets needed for every box</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>CEILING</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=CEILING(Invoice.C4*1.1;0.25)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=CEILING([Invoice.C4]*1.1;0.25)" office:value-type="float" office:value="2.25" calcext:value-type="float">
      <text:p>2.25</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Handout price plus 10%, up to the next quarter</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>CEILING</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=CEILING(Invoice.B9;-0.5;1)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=CEILING([Invoice.B9];-0.5;1)" office:value-type="float" office:value="-12.5" calcext:value-type="float">
      <text:p>-12.5</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>With a Mode, the credit rounds away from zero: -12.5</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>FLOOR</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=FLOOR(Times.B7/Times.B6)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=FLOOR([Times.B7]/[Times.B6])" office:value-type="float" office:value="6" calcext:value-type="float">
      <text:p>6</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Pallets that go out full</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>FLOOR</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=FLOOR(Invoice.C6*0.9;0.1)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=FLOOR([Invoice.C6]*0.9;0.1)" office:value-type="float" office:value="11.1" calcext:value-type="float">
      <text:p>11.1</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Catering with a 10% discount, down to the ten cents</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>COM.MICROSOFT.CEILING</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=COM.MICROSOFT.CEILING(Invoice.C2*1.03;5)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=COM.MICROSOFT.CEILING([Invoice.C2]*1.03;5)" office:value-type="float" office:value="100" calcext:value-type="float">
      <text:p>100</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Excel&apos;s CEILING: next year&apos;s hourly rate, up to a step of five</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>COM.MICROSOFT.CEILING</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=COM.MICROSOFT.CEILING(Invoice.B9;1)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=COM.MICROSOFT.CEILING([Invoice.B9];1)" office:value-type="float" office:value="-12" calcext:value-type="float">
      <text:p>-12</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Excel&apos;s CEILING on a credit goes towards zero: -12</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>COM.MICROSOFT.FLOOR</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=COM.MICROSOFT.FLOOR(Times.B5;30)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=COM.MICROSOFT.FLOOR([Times.B5];30)" office:value-type="float" office:value="180" calcext:value-type="float">
      <text:p>180</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The site visit in whole half hours</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>COM.MICROSOFT.FLOOR</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=COM.MICROSOFT.FLOOR(Invoice.B9;1)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=COM.MICROSOFT.FLOOR([Invoice.B9];1)" office:value-type="float" office:value="-13" calcext:value-type="float">
      <text:p>-13</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Excel&apos;s FLOOR on a credit goes away from zero: -13</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <table:named-expressions/>
  </office:spreadsheet>
 </office:body>
