   <table:calculation-settings table:case-sensitive="false" table:use-regular-expressions="false" table:use-wildcards="true"/>
   <table:table table:name="Customers" table:style-name="ta1">
    <table:table-column table:style-name="wide" table:number-columns-repeated="8" table:default-cell-style-name="Default"/>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>ID</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Name</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Email</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Phone</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>City</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Postcode</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Code</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Since</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>C-0042</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p><text:s text:c="2"/>maria <text:s/>ESPOSITO </text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>maria.esposito@example.org</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>+49 30 1234567</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>berlin</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>10115</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ESP-BER-42</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="2019" calcext:value-type="float">
      <text:p>2019</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>C-0043</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Tom O&apos;Neill</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>tom.oneill@example.com</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>+44 20 7946 0958</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>London</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>SW1A 1AA</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ONE-LON-43</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="2021" calcext:value-type="float">
      <text:p>2021</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>C-0044</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Aiko Tanaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>aiko@example.net</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>+81 3 1234 5678</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Tokyo</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>100-0001</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>TAN-TOK-44</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="2023" calcext:value-type="float">
      <text:p>2023</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>C-0045</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Lars Eriksen</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>lars.eriksen@example.org</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>+45 33 12 34 56</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Copenhagen</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>1050</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>ERI-COP-45</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="float" office:value="2018" calcext:value-type="float">
      <text:p>2018</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <table:table table:name="Samples" table:style-name="ta1">
    <table:table-column table:style-name="co3" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co4" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co5" table:default-cell-style-name="Default"/>
    <table:table-column table:style-name="co4" table:default-cell-style-name="Default"/>
    <table:table-row table:style-name="ro1">
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Function</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Formula</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>Result</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce2" office:value-type="string" calcext:value-type="string">
      <text:p>What it shows</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>TRIM</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=TRIM(Customers.B2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=TRIM([Customers.B2])" office:value-type="string" office:string-value="maria ESPOSITO" calcext:value-type="string">
      <text:p>maria ESPOSITO</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Maria&apos;s name without the stray spaces</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>PROPER</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=PROPER(TRIM(Customers.B2))</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=PROPER(TRIM([Customers.B2]))" office:value-type="string" office:string-value="Maria Esposito" calcext:value-type="string">
      <text:p>Maria Esposito</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>…and in the case a letter is addressed in</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>PROPER</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=PROPER(Customers.E2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=PROPER([Customers.E2])" office:value-type="string" office:string-value="Berlin" calcext:value-type="string">
      <text:p>Berlin</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A city typed in lower case</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>UPPER</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=UPPER(Customers.E3)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=UPPER([Customers.E3])" office:value-type="string" office:string-value="LONDON" calcext:value-type="string">
      <text:p>LONDON</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A city for a shipping label</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>LOWER</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=LOWER(Customers.G2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=LOWER([Customers.G2])" office:value-type="string" office:string-value="esp-ber-42" calcext:value-type="string">
      <text:p>esp-ber-42</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A customer code for a URL</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>LEN</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=LEN(Customers.D3)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=LEN([Customers.D3])" office:value-type="float" office:value="16" calcext:value-type="float">
      <text:p>16</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Characters in Tom&apos;s phone number</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>LEFT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=LEFT(Customers.G3;3)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=LEFT([Customers.G3];3)" office:value-type="string" office:string-value="ONE" calcext:value-type="string">
      <text:p>ONE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The surname part of a customer code</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>RIGHT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=RIGHT(Customers.A4;4)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=RIGHT([Customers.A4];4)" office:value-type="string" office:string-value="0044" calcext:value-type="string">
      <text:p>0044</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The number part of an ID</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>MID</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=MID(Customers.G4;5;3)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=MID([Customers.G4];5;3)" office:value-type="string" office:string-value="TOK" calcext:value-type="string">
      <text:p>TOK</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The city part of a customer code</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>FIND</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=FIND(&quot;@&quot;;Customers.C3)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=FIND(&quot;@&quot;;[Customers.C3])" office:value-type="float" office:value="11" calcext:value-type="float">
      <text:p>11</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Where the domain of Tom&apos;s address begins</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>FIND</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=LEFT(Customers.C3;FIND(&quot;@&quot;;Customers.C3)-1)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=LEFT([Customers.C3];FIND(&quot;@&quot;;[Customers.C3])-1)" office:value-type="string" office:string-value="tom.oneill" calcext:value-type="string">
      <text:p>tom.oneill</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>The user name in front of it</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>SEARCH</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=SEARCH(&quot;example.org&quot;;Customers.C2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=SEARCH(&quot;example.org&quot;;[Customers.C2])" office:value-type="float" office:value="16" calcext:value-type="float">
      <text:p>16</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>SEARCH finds text too</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>SEARCH</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=ISNUMBER(SEARCH(&quot;ORG&quot;;Customers.C5))</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce3" table:formula="of:=ISNUMBER(SEARCH(&quot;ORG&quot;;[Customers.C5]))" office:value-type="boolean" office:boolean-value="true" calcext:value-type="boolean">
      <text:p>TRUE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>…without minding case, which FIND would</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>SUBSTITUTE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=SUBSTITUTE(Customers.D3;&quot; &quot;;&quot;&quot;)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=SUBSTITUTE([Customers.D3];&quot; &quot;;&quot;&quot;)" office:value-type="string" office:string-value="+442079460958" calcext:value-type="string">
      <text:p>+442079460958</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A phone number as one string of digits</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>SUBSTITUTE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=SUBSTITUTE(Customers.G2;&quot;-&quot;;&quot;/&quot;;2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=SUBSTITUTE([Customers.G2];&quot;-&quot;;&quot;/&quot;;2)" office:value-type="string" office:string-value="ESP-BER/42" calcext:value-type="string">
      <text:p>ESP-BER/42</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Only the second dash replaced</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>REPLACE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=REPLACE(Customers.D2;1;3;&quot;0&quot;)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=REPLACE([Customers.D2];1;3;&quot;0&quot;)" office:value-type="string" office:string-value="0 30 1234567" calcext:value-type="string">
      <text:p>0 30 1234567</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>Maria&apos;s number in German national format</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>REPT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=REPT(&quot;*&quot;;LEN(Customers.D3)-4)&amp;RIGHT(Customers.D3;4)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=REPT(&quot;*&quot;;LEN([Customers.D3])-4)&amp;RIGHT([Customers.D3];4)" office:value-type="string" office:string-value="************0958" calcext:value-type="string">
      <text:p>************0958</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A phone number masked for a receipt</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>CONCATENATE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=CONCATENATE(PROPER(TRIM(Customers.B2));&quot; &lt;&quot;;Customers.C2;&quot;&gt;&quot;)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=CONCATENATE(PROPER(TRIM([Customers.B2]));&quot; &lt;&quot;;[Customers.C2];&quot;&gt;&quot;)" office:value-type="string" office:string-value="Maria Esposito &lt;maria.esposito@example.org&gt;" calcext:value-type="string">
      <text:p>Maria Esposito &lt;maria.esposito@example.org&gt;</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>An address line for an email</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>EXACT</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=EXACT(Customers.E3;&quot;london&quot;)</text:p>
     </table:table-cell>
     <table:table-cell table:style-name="ce3" table:formula="of:=EXACT([Customers.E3];&quot;london&quot;)" office:value-type="boolean" office:boolean-value="false" calcext:value-type="boolean">
      <text:p>FALSE</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>EXACT minds case: London is not london</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>T</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=T(Customers.F4)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([Customers.F4])" office:value-type="string" office:string-value="100-0001" calcext:value-type="string">
      <text:p>100-0001</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A postcode is text, so T keeps it</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>T</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=T(Customers.H2)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=T([Customers.H2])">
      <text:p/>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A year is a number, so T gives nothing</text:p>
     </table:table-cell>
    </table:table-row>
    <table:table-row table:style-name="ro1">
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>HYPERLINK</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>=HYPERLINK(&quot;mailto:&quot;&amp;Customers.C4;Customers.B4)</text:p>
     </table:table-cell>
     <table:table-cell table:formula="of:=HYPERLINK(&quot;mailto:&quot;&amp;[Customers.C4];[Customers.B4])" office:value-type="string" office:string-value="Aiko Tanaka" calcext:value-type="string">
      <text:p>Aiko Tanaka</text:p>
     </table:table-cell>
     <table:table-cell office:value-type="string" calcext:value-type="string">
      <text:p>A link that writes to Aiko</text:p>
     </table:table-cell>
    </table:table-row>
   </table:table>
   <table:named-expressions/>
  </office:spreadsheet>
 </office:body>
</office:document>