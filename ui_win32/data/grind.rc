// W8's version resource and icon (doc/windows-shell.md). `build.rs` compiles this with
// `embed_resource` and links it into `grind-win32.exe` — Explorer's Properties dialog, the
// taskbar thumbnail and the executable's own icon all read it, and it is why this file exists
// rather than the two being wired up separately: an icon with no version block and a version
// block with no icon are each half the reason a shell "looks native" on Windows.
//
// `grind.svg` is the source; `grind.ico` beside it is generated from it (`magick -background
// none grind.svg -define icon:auto-resize=256,128,64,48,32,16 grind.ico`) rather than built by
// this crate, because turning an SVG into an ICO needs librsvg and this build must not gain a
// dependency on it for six pixels nobody edits at build time.
1 ICON "grind.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,0,0
PRODUCTVERSION  0,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Florian Wilhelm"
            VALUE "FileDescription",  "Grind - an ODF-native office suite"
            VALUE "FileVersion",      "0.0.0.0"
            VALUE "InternalName",     "grind-win32"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Florian Wilhelm"
            VALUE "OriginalFilename", "grind-win32.exe"
            VALUE "ProductName",      "Grind"
            VALUE "ProductVersion",   "0.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
