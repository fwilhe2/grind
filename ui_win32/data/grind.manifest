<!-- grind-win32's application manifest, linked in by grind.rc (doc/windows-shell.md, decision 12).
     Three things, and each is a thing Windows decides before a line of this program runs:
     the Common Controls version every EDIT, LISTBOX, scroll bar and menu is drawn by (6, the
     themed one — without this line they are Windows 2000's), the DPI awareness (per-monitor v2,
     which `win::run` also asks for at run time and which is only *reliably* had from here), and
     the Windows versions this program was written for, without which Windows 10 and 11 run it
     with the compatibility shims meant for programs that predate them. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <assemblyIdentity type="win32" name="Grind.Grind" version="0.0.0.0" processorArchitecture="*"/>
  <dependency>
    <dependentAssembly>
      <assemblyIdentity type="win32" name="Microsoft.Windows.Common-Controls" version="6.0.0.0"
                        processorArchitecture="*" publicKeyToken="6595b64144ccf1df" language="*"/>
    </dependentAssembly>
  </dependency>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 share one id. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
