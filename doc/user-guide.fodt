       <text:p>grind for Windows</text:p>
      </table:table-cell>
      <table:table-cell>
       <text:p>Both, in one window</text:p>
      </table:table-cell>
      <table:table-cell>
       <text:p>Windows</text:p>
      </table:table-cell>
     </table:table-row>
     <table:table-row>
      <table:table-cell>
       <text:p>grind for Mac</text:p>
      </table:table-cell>
      <table:table-cell>
       <text:p>Both, in one window</text:p>
      </table:table-cell>
      <table:table-cell>
       <text:p>macOS</text:p>
      </table:table-cell>
     </table:table-row>
     <table:table-row>
      <table:table-cell>
       <text:p>grind (the command line)</text:p>
      </table:table-cell>
      <table:table-cell>
       <text:p>Every function, from the shell</text:p>
