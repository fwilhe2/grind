# Built on the Debian release the image runs on. Bare `rust:1` follows Debian's newest
# (trixie, glibc 2.41) while cc-debian12 is bookworm (glibc 2.36), so a binary linked there
# may ask for a glibc the image does not have — which the arm64 build started doing, and the
# "Print Sheet Version" step caught (`GLIBC_2.39' not found). Bump both together.
FROM rust:1-bookworm AS build-env
WORKDIR /app
COPY . /app
RUN cargo build --release -p grind-cli

FROM gcr.io/distroless/cc-debian12
COPY --from=build-env /app/target/release/grind /
CMD ["./grind"]