# `soffice`, run out of the pinned container image (ci/libreoffice-image) instead of
# whatever a machine happens to have installed. Put this directory first on `PATH` and every
# test that shells out to `soffice` — loop C, loop E, the kb render check — talks to the pin
# without knowing it; nothing in the Rust needs to learn about Docker. That is the whole
# trick, and it is why the oracle is the same binary on a laptop and in CI.
#
# The container sees the host's temp directory at the same path, because that is where the
# tests stage every input and collect every output (`Lab` in core/tests/roundtrip.rs and
# loop_e.rs both build under `std::env::temp_dir()`). Nothing else is mounted: a converter
# that could reach the repository would be a worse oracle, not a better one.
set -euo pipefail

image=$(cat "$(dirname "$(readlink -f "$0")")/../../ci/libreoffice-image")
tmp=$(cd "${TMPDIR:-/tmp}" && pwd -P)

# `label=disable`: on an SELinux-enforcing host (Fedora, RHEL) the bind mount below is labelled
# for the host and a container process may read it but not write to it, so `soffice` cannot
# create its own `UserInstallation` profile and dies with "User installation could not be
# completed" — every loop C and loop E test then fails for a reason that has nothing to do with
# the code. The alternative, `-v "$tmp:$tmp:z"`, relabels the host's whole temp directory as a
# side effect of running a test, which is not a trade a test harness gets to make. A no-op where
# SELinux is not enforcing, which includes CI.
exec docker run --rm \
    --security-opt label=disable \
    --user "$(id -u):$(id -g)" \
    -v "$tmp:$tmp" \
    -e "HOME=$tmp" \
    -e "TMPDIR=$tmp" \
    -w "$tmp" \
    "$image" \
    soffice "$@"
