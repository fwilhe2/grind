{
  "permissions": {
    "deny": [
      "Edit(/README.md)",
      "Edit(/README.fodt)",
      "Write(/README.md)",
      "Write(/README.fodt)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-readme.sh"
          }
        ]
      }
    ]
  }
}
